# ==============================================================================
# Trade.2026 Signal Monitor — Environment Variables
# KHÔNG BAO GIỜ commit file .env.local hay dán secret vào chat/code.
# Cấu hình trực tiếp trên Vercel Dashboard → Project Settings → Environment Variables.
# ==============================================================================

# 1. Supabase (supabase-almond-fence, ref: fagveiomuwuyuzzeepvk)
# LƯU Ý: Auth Supabase của Trade.2026 CHỈ dùng header `apikey` (KHÔNG gửi Authorization Bearer).
# Chấp nhận SUPABASE_API_KEY hoặc SUPABASE_SERVICE_KEY (tên biến giống VPS /opt/trade2026/.env).
SUPABASE_URL=https://fagveiomuwuyuzzeepvk.supabase.co
SUPABASE_API_KEY=
# SUPABASE_SERVICE_KEY=

# Tên bảng trong Supabase (mặc định theo spec)
SUPABASE_SIGNALS_TABLE=signals
SUPABASE_RECEIPTS_TABLE=delivery_receipts
SUPABASE_HEARTBEAT_TABLE=heartbeats

# 2. Nguồn xác minh thứ 2 (tùy chọn — VPS Linode heartbeat / log endpoint)
# Nếu có endpoint trả JSON { sent_ids: string[], last_run_at: string, ... }
VPS_HEARTBEAT_URL=
VPS_HEARTBEAT_TOKEN=

# 3. Telegram Alert (chỉ gửi cảnh báo MẤT đã xác minh 2 nguồn & báo cáo ngày)
# Chấp nhận TELEGRAM_BOT_TOKEN hoặc BOT_TOKEN_TRADEMRBIT; TELEGRAM_CHAT_ID hoặc SIGNAL_CHAT_ID / CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# BOT_TOKEN_TRADEMRBIT=
# SIGNAL_CHAT_ID=

# 4. Bảo mật cho Vercel Cron & trigger thủ công (tùy chọn)
CRON_SECRET=

# 5. Chế độ chạy: "live" | "demo" (tự động fallback về "demo" nếu chưa có SUPABASE_API_KEY)
MONITOR_MODE=auto
